# Runtime mode. Keep true for the synthetic local demo. Production must set false.
DEMO_MODE=true

# Canonical application identity. Replace placeholders only during authorized provisioning.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PRODUCT_NAME=Family Tree Designer
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.invalid

# Dedicated production Postgres and Supabase project (unprovisioned).
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required before production invitation/session signing.
INVITE_TOKEN_PEPPER=
VIEWER_SESSION_SECRET=

# Optional observability. Never enable session replay on private family routes.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
